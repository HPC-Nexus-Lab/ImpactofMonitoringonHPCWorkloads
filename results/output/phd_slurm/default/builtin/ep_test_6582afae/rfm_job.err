++ ls /sys/devices/system/cpu/cpufreq/
++ wc -l
+ COUNT=56
+ echo 'Using 56 of 56, take 56-56 offline'
++ python3 -c 'from numpy import linspace
for val in linspace(1, 56-1, 56-56):
    print(f"/sys/devices/system/cpu/cpu{int(val)}/online")
'
